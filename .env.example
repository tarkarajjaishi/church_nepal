# =======================
# ENVIRONMENT CONFIGURATION
# =======================

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Rust API Backend
DATABASE_URL=postgres://postgres:password@localhost:5432/grace_church_dev
PORT=3002
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-must-be-32-chars

# Site domain — where a payment gateway sends the donor back to, for both the
# success and the failure URL. Getting it wrong loses the donor at the one
# moment they have actually paid, so it is worth checking after any port change.
# In development this is http://localhost:3005, which is the port the church app
# runs on; unset, the code falls back to exactly that.
SITE_DOMAIN=https://churchnepal.com

# eSewa Payment Gateway
ESEWA_MERCHANT_ID=
ESEWA_SECRET_KEY=
ESEWA_BASE_URL=https://uat.esewa.com.np

# Khalti Payment Gateway
KHALTI_SECRET_KEY=
KHALTI_PUBLIC_KEY=
KHALTI_BASE_URL=https://a.khalti.com/api/v2

# Stripe Payment Gateway
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=

# Logging
RUST_LOG=info

# Shared secret the control plane uses to refresh a tenant cache entry after
# provisioning. Leave blank to disable the endpoint entirely.
INTERNAL_API_SECRET=
