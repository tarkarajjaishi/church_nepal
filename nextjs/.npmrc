# @testing-library/react@15 pins @types/react@^18 and this project is on 19, so
# npm refuses to resolve and every install fails with ERESOLVE — in CI, in
# Docker, and locally. Setting it here fixes all three at once instead of
# repeating a flag at each call site.
#
# The real fix is bumping @testing-library/react to v16 (its first release
# supporting React 19) and re-running the vitest suite.
legacy-peer-deps=true
